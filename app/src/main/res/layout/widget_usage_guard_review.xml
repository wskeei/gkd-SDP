<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/usage_guard_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/usage_guard_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_usage_review_title_default"
        android:textColor="@color/better_black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/usage_guard_widget_metric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_usage_review_metric_default"
        android:textColor="@color/better_black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/usage_guard_widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.7"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_usage_review_hint_default"
        android:textColor="@color/better_black"
        android:textSize="12sp" />

</LinearLayout>
